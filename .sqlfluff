[sqlfluff]
dialect = postgres
templater = dbt
max_line_length = 100

[sqlfluff:templater:dbt]
project_dir = .    # dbt_project.yml がある場所
profiles_dir = ~/.dbt

# ルール選択（ベースライン）
[sqlfluff:rules]
# 例：命名・Jinja 周り・単語ケース等（好みで調整）
comma_style = trailing
indent_unit = space
tab_space_size = 2

# 一部ルールの詳細調整例
[sqlfluff:rules:L010]  # capitalization of keywords
capitalisation_policy = lower

[sqlfluff:rules:Jinja]  # Jinja の空白等